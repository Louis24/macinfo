# Copy this file to .env.local (git-ignored) and fill in your own values.
# Both scripts/0_init_local_git.bat and scripts/1_mac-ci.ps1 read it from the project root.

# A GitHub token with the "repo" scope: needed to push, to read Actions runs, to download
# artifacts, and to create the remote repository when it does not exist yet.
GITHUB_TOKEN=ghp_replace_me

# Optional: only if you reach GitHub through a local proxy.
HTTPS_PROXY=http://127.0.0.1:7890

# The repository this project publishes to. Used when there is no "origin" remote to read,
# i.e. right after .git was deleted or on a new machine. 0_init_local_git.bat turns it into
# origin = https://github.com/<owner>/<repo>.git
GITHUB_REPO=your-login/macinfo
